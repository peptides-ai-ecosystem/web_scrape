!migrations/migration_vendor_price_observations.sql
!migrations/migration_vendor_scrape_targets.sql
*.csv
sync_supabase.sh
viz_server.py
docker-compose.yml

# --- Docs (not needed at runtime) ---
README.md
docs/
*.md
