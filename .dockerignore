# --- Python ---
.venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# --- Secrets / local config (NEVER bake into image — .env lives on the host) ---
.env
.env.*
!.env.example

# --- Source control / IDE noise ---
.git
.gitignore
.cursor
.DS_Store
.vscode
.idea

# --- Local runtime artefacts (mount a volume instead) ---
output/
log/
output_1/
output_2/
output_v2/
output_v3/
output_v4/
output_v5/
output_v6/
graphify-out/
peptides_temp/
graph_html/

# --- Local-only assets ---
# Hand-run platform SQL (migrations/) is never shipped.
*.sql
migrations/*
*.csv
scripts/ops/
viz_server.py
docker-compose.yml

# --- Docs (not needed at runtime) ---
README.md
docs/
*.md
