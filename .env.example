# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/peptides

# Selenium Configuration (timeout in seconds)
TIMEOUT=5

# Directory Configuration
OUTPUT_DIR=output
LOG_DIR=output

# ── Gateway integration ─────────────────────────────────────────────────────
# Shared secret the orchestrator gateway presents in the header below.
# Leave empty for local development without gateway auth.
API_TOKEN=
# Header that carries the gateway token (default matches the orchestrator).
GATEWAY_AUTH_HEADER=X-Gateway-Token
# Start the APScheduler background sync on boot. Set false when the
# orchestrator/gateway manages sync scheduling.
START_SCHEDULER=true

# ── Competitor vendor scraping (peptides-platform#288) ──────────────────────
# Targets are managed from the admin (Pepti.AI -> Scrape) and stored in the
# vendor_scrape_targets table. This file is an optional seed / fallback: its
# targets apply only where no DB target has the same slug.
# Copy config/vendor_targets.example.json to start from a file.
VENDOR_TARGETS_FILE=config/vendor_targets.json
# We identify ourselves honestly to the sites we read. Point the contact URL at
# somewhere a site owner who wants us to stop can actually reach us.
VENDOR_SCRAPER_CONTACT_URL=https://github.com/peptides-ai-ecosystem/web_scrape
# Leave unset to get "PeptidesVendorScraper/1.0 (+$VENDOR_SCRAPER_CONTACT_URL)".
# Do not set this to a browser string — we do not pretend to be a person.
VENDOR_SCRAPER_USER_AGENT=
# Politeness floor, seconds between requests to the same host. The effective
# delay is the largest of this, the target's own setting, and the site's
# robots.txt Crawl-delay.
VENDOR_SCRAPE_MIN_INTERVAL_SECONDS=5.0
# Retries on 429/5xx before the host is abandoned for the run.
VENDOR_SCRAPE_MAX_RETRIES=2
VENDOR_SCRAPE_BACKOFF_SECONDS=30.0
VENDOR_SCRAPE_TIMEOUT_MS=20000
# SSRF guard: targets on loopback / private / link-local (cloud metadata) /
# multicast / reserved addresses are refused at save and at fetch time.
# true turns that off for LOCAL TESTING ONLY (a fixture site on 127.0.0.1).
# Never set it in a deployed environment.
VENDOR_SCRAPE_ALLOW_PRIVATE_TARGETS=false
# Relative price move that flags a reading for review instead of letting it
# replace the last accepted price. 0.25 == 25%.
VENDOR_PRICE_DELTA_THRESHOLD=0.25
# Extraction confidence below which a reading is always flagged.
VENDOR_MIN_CONFIDENCE=0.6
# Nightly cron. Off by default — turn it on deliberately, per environment.
VENDOR_SCRAPE_CRON_ENABLED=false
VENDOR_SCRAPE_CRON_HOUR=3
VENDOR_SCRAPE_CRON_MINUTE=15
# Forwarding accepted readings into the platform's vendor_products table.
# Not implemented and cannot be: that table has no 'source' column, requires a
# non-null wc_product_id, and lives in a database this service has no
# credentials for. See src/services/vendor_products_publisher.py.
VENDOR_PRODUCTS_PUBLISH_ENABLED=false
# PeptiPrices gets accepted readings by PULL instead: the platform API reads
# GET /api/v1/vendors/observations/accepted-latest through the gateway and
# imports them through its own pricing service (admin "Import accepted").
# Create vendor_price_observations + vendor_scrape_targets on startup
# (idempotent). Set false where the DB role cannot run DDL.
VENDOR_SCHEMA_AUTO_CREATE=true

# ── Sentry error capture (FEEDBACK-3 G15) ──────────────────────────────────
# Empty = Sentry fully off: sentry_sdk.init is never called, nothing is sent.
# On EC2 the deploy workflow's `set_sentry_dsn` input writes this line.
SENTRY_DSN=
# Blank -> $ENVIRONMENT, else production.
SENTRY_ENVIRONMENT=
# Blank -> $GIT_SHA (set by the Dockerfile build arg).
SENTRY_RELEASE=
# Performance tracing. Errors are captured regardless; keep this at 0.
SENTRY_TRACES_SAMPLE_RATE=0.0
